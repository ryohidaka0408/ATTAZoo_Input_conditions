{
  "name": "attazoo-input-conditions-plugin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js && node scripts/copy-static.js",
    "dev": "node scripts/build.js --watch",
    "keygen": "npx @kintone/cli plugin keygen --output private.ppk",
    "pack": "npm run build && npx @kintone/cli plugin pack --input dist/manifest.json --output plugin.zip --private-key private.ppk",
    "upload": "npx @kintone/cli plugin upload --input plugin.zip --base-url %KINTONE_BASE_URL% --username %KINTONE_USERNAME% --password %KINTONE_PASSWORD%"
  },
  "devDependencies": {
    "@kintone/cli": "latest",
    "vite": "^5.0.0"
  }
}
